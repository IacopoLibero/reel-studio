{
  "compilerOptions": {
    "target": "ES2018",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "lib": [
      "es2015"
    ],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "baseUrl": ".",
    "paths": {
      "@kit/*": [
        "src/kit/*"
      ],
      "@cover/*": [
        "src/cover/*"
      ],
      "*": [
        "node_modules/@types/*",
        "node_modules/*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "platform",
    "remotion.config.ts",
    "src/_tmp"
  ],
  "include": [
    "src",
    "../data/brands/*/code",
    "../data/brands/*/reels/*/code"
  ]
}
