# Reel Hub configuration. ./install.sh creates .env from this file and fills in the machine-specific values.
# .env holds the hub token: it is git-ignored, chmod 600, and must never be shared or committed.

# --- stack names and ports (change them to run a second copy next to the first one) ---
COMPOSE_PROJECT_NAME=reel-studio     # prefix of the Docker volumes: <name>_hub-data, <name>_chrome-profile, ...
CONTAINER_NAME=reel-hub
IMAGE_NAME=reel-hub
HUB_PORT=4000                        # the web hub, published on 127.0.0.1 only
VOICE_PORT=3900                      # the VoiceStudio API, published on 127.0.0.1 only

# --- access ---
HUB_TOKEN=                           # created by install.sh (random, 48 hex characters). The hub asks for it once.

# --- the host user, so files made in the container belong to you (install.sh detects them) ---
HOST_USER=
HOST_UID=
HOST_GID=
HOST_HOME=
REEL_ROOT=                           # absolute path of this repository; mounted at the same path in the container

# --- hardware ---
GPU=0                                # 1 = pass the NVIDIA GPU to the container (needs the NVIDIA Container Toolkit)
VOICE_DEVICE=cpu                     # gpu | cpu: where the voice engine runs. gpu needs about 8 GB of GPU memory
BLENDER_DEVICE=cpu                   # cpu | gpu | auto: how Blender renders the mascot (cpu works everywhere)
VOICE_ENGINE_INSTALL=1               # 0 = install VoiceStudio but not its VoxCPM2 engine and model (about 15 GB less)
TZ=Europe/Rome                       # time zone used for posting slots

# --- brands ---
# Brands are not configured here. Each brand has its own brand/<slug>/brand.json (Instagram account and user id, source texts
# folder, offer rule, colours, fonts, closing lines). Create one in the hub ("New brand") or with ./scripts/new-brand.sh.
# An installation made before brands existed may still carry BRAND, IG_USER_ID, IG_ACCOUNT, BLOG_DIR, OFFER_LAST_DAY and
# OFFER_REGEX below: the first start of the hub copies them once into that brand's brand.json and then ignores them.
BLOG_MOUNT=                          # folder mounted read-only in the container when a brand's source texts are outside the project
