#!/bin/bash
# Opens Reel Studio as an app window. Starts the hub (a systemd user service) if it is not running, waits for it,
# gets a one-time sign-in pass (the token never appears on a command line) and opens the window.
#
#   reel-studio                  open the app
#   reel-studio --autostart on   keep the hub running from login (daily loops and Instagram scheduling go on with the window closed)
#   reel-studio --autostart off
#   reel-studio --stop           stop the hub
#   reel-studio --status         say whether the hub runs
set -euo pipefail
STUDIO="${REEL_STUDIO_HOME:-$HOME/ReelStudio}"
DATA="$STUDIO/data"
PORT="${HUB_PORT:-4000}"
URL="http://127.0.0.1:$PORT"
UNIT=reel-studio.service

case "${1:-}" in
  --autostart)
    case "${2:-}" in
      on) systemctl --user enable --now "$UNIT"; echo "Reel Studio will start at login." ;;
      off) systemctl --user disable "$UNIT"; echo "Reel Studio will not start at login." ;;
      *) echo "usage: reel-studio --autostart on|off" >&2; exit 2 ;;
    esac; exit 0 ;;
  --stop) systemctl --user stop "$UNIT"; echo "Reel Studio stopped."; exit 0 ;;
  --status) systemctl --user is-active "$UNIT" || true; exit 0 ;;
  ""|--open) ;;
  *) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac

browser=""
for b in chromium google-chrome-stable google-chrome chromium-browser brave; do command -v "$b" >/dev/null 2>&1 && { browser="$b"; break; }; done
[ -n "$browser" ] || { echo "Reel Studio needs Chromium or Google Chrome: sudo pacman -S chromium" >&2; exit 1; }

systemctl --user start "$UNIT"
for _ in $(seq 1 60); do curl -fsS -m 2 "$URL/api/health" >/dev/null 2>&1 && break; sleep 1; done
curl -fsS -m 2 "$URL/api/health" >/dev/null 2>&1 || { echo "The hub did not start. See: journalctl --user -u $UNIT" >&2; exit 1; }

# The hub makes its own token the first time (data/dev-token, readable only by you).
for _ in $(seq 1 20); do [ -s "$DATA/dev-token" ] && break; sleep 0.5; done
[ -s "$DATA/dev-token" ] || { echo "No token in $DATA/dev-token" >&2; exit 1; }
nonce="$(printf 'Authorization: Bearer %s\n' "$(tr -d '\n' <"$DATA/dev-token")" | curl -fsS -m 5 -X POST -H @- "$URL/api/enter-nonce" | sed -n 's/.*"nonce":"\([0-9a-f]*\)".*/\1/p')"
[ -n "$nonce" ] || { echo "The hub did not give a sign-in pass." >&2; exit 1; }

exec "$browser" --app="$URL/api/enter?n=$nonce" --class=reel-studio --user-data-dir="$STUDIO/.app-window" --no-first-run --no-default-browser-check
