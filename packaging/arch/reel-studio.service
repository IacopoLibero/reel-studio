[Unit]
Description=Reel Studio hub
After=network.target

[Service]
Type=simple
WorkingDirectory=/usr/lib/reel-studio/platform/hub
Environment=REEL_STUDIO_HOME=%h/ReelStudio
Environment=PATH=%h/.local/bin:%h/.npm-global/bin:/usr/local/bin:/usr/bin:/opt/cuda/bin
ExecStart=/usr/bin/node dist/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=20

[Install]
WantedBy=default.target
