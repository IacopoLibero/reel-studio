#!/bin/bash
# Runs the VoiceStudio backend (port VOICE_PORT, default 3900) for supervisord. On first start it installs VoiceStudio
# from the official source (github.com/debpalash/VoiceStudio, pinned tag) and its VoxCPM2 engine, into the named volumes.
# Safe to run again: finished steps are skipped, an interrupted download is retried (uv keeps its cache in a volume).
# Progress is written to $STATUS so install.sh can show it. Nothing is copied from the host.
set -u
H="${HOME:?}"
PORT="${VOICE_PORT:-3900}"
PROJECT="$H/.config/VoiceStudio/runtime/project"
STATUS="$H/.config/VoiceStudio/reel-bootstrap.status"
REPO="${VOICESTUDIO_REPO:?}"; REF="${VOICESTUDIO_REF:?}"
DEVICE="${VOICE_DEVICE:-gpu}"
export UV_HTTP_TIMEOUT=900 UV_HTTP_RETRIES=5 UV_CONCURRENT_DOWNLOADS=2 UV_CACHE_DIR="$H/.cache/uv" UV_LINK_MODE=copy
say() { echo "[voicestudio-run] $*"; printf '%s %s\n' "$(date -Is)" "$*" >>"$STATUS"; }
state() { printf '%s' "$1" >"$H/.config/VoiceStudio/reel-bootstrap.state"; }
fail() { say "FAILED: $1 (retrying in 60 s)"; state "failed"; sleep 60; exit 1; }
mkdir -p "$H/.config/VoiceStudio/runtime"

# 1. source
if [ ! -f "$PROJECT/pyproject.toml" ]; then
  state "downloading VoiceStudio $REF"; say "cloning $REPO ($REF)"
  rm -rf "$PROJECT.tmp"
  git clone --depth 1 --branch "$REF" "$REPO" "$PROJECT.tmp" || fail "git clone"
  rm -rf "$PROJECT" && mv "$PROJECT.tmp" "$PROJECT"
fi
cd "$PROJECT" || fail "no project dir"

# 2. Python environment (torch and about 230 packages; CUDA build for gpu, CPU build for cpu)
if ! .venv/bin/python -c "import torch, fastapi, uvicorn" 2>/dev/null; then
  state "installing Python packages (large download)"
  if [ "$DEVICE" = cpu ]; then GROUP=(--no-group cuda --group cpu); else GROUP=(--group cuda); fi
  say "uv sync --frozen --no-dev ${GROUP[*]} (about 10 GB for gpu, 1 GB for cpu)"
  uv sync --frozen --no-dev --python 3.11 "${GROUP[@]}" || fail "uv sync"
fi

# 3. start the server in the background, wait for it, then install the voice engine through its own installer API
if [ "$DEVICE" = cpu ]; then export CUDA_VISIBLE_DEVICES=""; else export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"; fi
export OMNIVOICE_PORT="$PORT"
state "starting"
.venv/bin/python -m uvicorn main:app --app-dir backend --host 0.0.0.0 --port "$PORT" &
SERVER=$!
trap 'kill $SERVER 2>/dev/null' TERM INT

engine_setup() {
  local base="http://127.0.0.1:$PORT"
  for _ in $(seq 1 120); do curl -fsS -m 3 "$base/health" >/dev/null 2>&1 && break; sleep 3; done
  curl -fsS -m 3 "$base/health" >/dev/null 2>&1 || { say "server did not answer on port $PORT"; return 1; }
  if [ -f "$H/.omnivoice/.reel-engine-ready" ] || [ -f "$H/.omnivoice/engines/voxcpm2/voxcpm2/.voicestudio_install_complete" ]; then state "ready"; return 0; fi
  if [ "${VOICE_ENGINE_INSTALL:-1}" != 1 ]; then say "engine install skipped (VOICE_ENGINE_INSTALL=0)"; state "ready (no engine)"; return 0; fi
  state "installing the VoxCPM2 engine"; say "POST /engines/sidecar/voxcpm2/install"
  curl -fsS -m 30 -X POST "$base/engines/sidecar/voxcpm2/install" >/dev/null || { say "engine install request failed"; return 1; }
  local st last="" py=.venv/bin/python
  for _ in $(seq 1 1440); do   # up to 2 hours
    st="$(curl -fsS -m 10 "$base/engines/sidecar/voxcpm2/install/status" 2>/dev/null | "$py" -I -c '
import json, sys
try:
    d = json.load(sys.stdin)
    j = d.get("job") or {}
    steps = j.get("steps") or []
    cur = next((x.get("id", "") for x in steps if x.get("state") == "running"), "")
    print("installed" if d.get("installed") else j.get("state", "waiting"), cur)
except Exception:
    print("waiting")' 2>/dev/null)"
    if [ "$st" != "$last" ]; then say "engine: $st"; last="$st"; fi
    case "$st" in
      installed*|succeeded*) break ;;
      failed*) say "engine install failed: see the VoiceStudio log"; return 1 ;;
    esac
    sleep 5
  done
  # the model weights (about 5 GB) go to the Hugging Face cache; also fetched on first use if this step fails
  say "downloading the VoxCPM2 model weights"
  HF_HUB_DISABLE_PROGRESS_BARS=1 .venv/bin/python - <<'PY' >>"$STATUS" 2>&1 || say "model download failed, it will be fetched on first use"
import json, pathlib
from huggingface_hub import snapshot_download
rev = None
try:
    for m in json.loads(pathlib.Path("backend/config/model_licenses.json").read_text()).get("models", []):
        if m.get("id") == "openbmb/VoxCPM2":
            rev = m.get("runtime_revision") or m.get("revision")
except Exception:
    pass
snapshot_download("openbmb/VoxCPM2", revision=rev)
PY
  curl -fsS -m 20 -X POST "$base/engines/select" -H 'Content-Type: application/json' -d '{"family":"tts","backend_id":"voxcpm2"}' >/dev/null 2>&1 || true
  touch "$H/.omnivoice/.reel-engine-ready"; state "ready"; say "VoiceStudio ready"
}
engine_setup &

wait "$SERVER"
