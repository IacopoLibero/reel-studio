#!/bin/bash
# Blender wrapper. BLENDER_DEVICE = cpu | gpu | auto  (default cpu)
#  cpu : software GL (Mesa llvmpipe) on the Xvfb display
#  gpu : NVIDIA GL/EGL through the nvidia container runtime
#  auto: gpu if nvidia-smi works, otherwise cpu
dev="${BLENDER_DEVICE:-cpu}"
if [ "$dev" = auto ]; then nvidia-smi -L >/dev/null 2>&1 && dev=gpu || dev=cpu; fi
export DISPLAY="${DISPLAY:-:99}"
if ! xdpyinfo -display "$DISPLAY" >/dev/null 2>&1; then
  Xvfb "$DISPLAY" -screen 0 1280x720x24 >/dev/null 2>&1 &
  XPID=$!; trap 'kill $XPID 2>/dev/null' EXIT
  for _ in $(seq 1 20); do xdpyinfo -display "$DISPLAY" >/dev/null 2>&1 && break; sleep 0.25; done
fi
case "$dev" in
  cpu) export LIBGL_ALWAYS_SOFTWARE=1 GALLIUM_DRIVER=llvmpipe __GLX_VENDOR_LIBRARY_NAME=mesa __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/50_mesa.json ;;
  gpu) unset LIBGL_ALWAYS_SOFTWARE GALLIUM_DRIVER; export __GLX_VENDOR_LIBRARY_NAME=nvidia ;;
  *) echo "blender-run: BLENDER_DEVICE must be cpu|gpu|auto" >&2; exit 2 ;;
esac
exec /usr/local/bin/blender-bin "$@"
